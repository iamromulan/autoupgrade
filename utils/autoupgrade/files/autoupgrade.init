#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

CRON_FILE="/etc/crontabs/root"
UPGRADE_BIN="/usr/bin/autoupgrade"

remove_cron() {
	[ -r "$CRON_FILE" ] || return
	sed -i "\|${UPGRADE_BIN}|d" "$CRON_FILE"
	/etc/init.d/cron restart 2>/dev/null
}

interval_to_cron() {
	local interval="$1"
	local hour="$2"
	local minute="$3"

	case "$interval" in
		daily)
			echo "$minute $hour * * *"
			;;
		weekly)
			echo "$minute $hour * * 0"
			;;
		monthly)
			echo "$minute $hour 1 * *"
			;;
		*)
			echo "$minute $hour * * *"
			;;
	esac
}

update_cron() {
	local enabled interval time hour minute cron_expr

	config_load "autoupgrade"
	config_get enabled settings enabled "0"
	config_get interval settings interval "daily"
	config_get time settings time "03:00"

	remove_cron

	[ "$enabled" != "1" ] && return

	hour="${time%%:*}"
	minute="${time##*:}"
	hour="${hour#0}"
	minute="${minute#0}"
	[ -z "$hour" ] && hour="0"
	[ -z "$minute" ] && minute="0"

	cron_expr="$(interval_to_cron "$interval" "$hour" "$minute")"

	echo "$cron_expr $UPGRADE_BIN" >> "$CRON_FILE"
	/etc/init.d/cron restart 2>/dev/null
}

start_service() {
	update_cron
}

stop_service() {
	remove_cron
}

reload_service() {
	update_cron
}

service_triggers() {
	procd_add_reload_trigger "autoupgrade"
}
